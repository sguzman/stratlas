{
  "schema_version": 1,
  "catalog": "../sources/catalog.json",
  "ontology": "model.json",
  "description": "Source-to-dataset-to-feature-to-presentation bindings. Status, endpoint, terms and verification remain authoritative in the source catalog; nothing here performs a network request.",
  "integration_rule": "A single geographic-data selector activates one thematic overlay at a time; source-bound summary values appear in the HUD at wide zoom, and real source features render at detailed zoom. No query-envelope rectangles are painted as geography. Raster basemaps remain independently selected.",
  "sources": [
    {
      "source_id": "osm",
      "source_kind": "raster_basemap",
      "delivery_kind": "xyz_raster_tile",
      "dataset_id": "dataset:osm",
      "feature_type": "web_mercator_tile",
      "scope": "provider_defined_global",
      "semantic_role": "cartographic_background",
      "runtime": {
        "module": "web/app.js",
        "map_layer": "basemap",
        "selector_value": "osm"
      },
      "identity": {
        "namespace": "osm",
        "key": "z/x/y"
      },
      "time_model": "provider_updated"
    },
