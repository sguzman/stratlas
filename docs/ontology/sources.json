    {
      "id": "basemap",
      "label": "Selected raster basemap",
      "presentation": "single_raster",
      "selection_element": "basemap",
      "source_ids": [
        "osm",
        "opentopomap",
        "usgs-topo",
        "usgs-relief",
        "usgs-imagery",
        "carto-voyager",
