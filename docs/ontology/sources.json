      "feature_type": "web_mercator_tile",
      "retrieval": "Only intersecting XYZ tiles, depending on user basemap selection."
    },
    {
      "id": "zoning",
      "label": "LA City zoning",
      "presentation": "categorical_fill_with_highlight",
      "selection_element": "acs-metric",
      "source_ids": [
        "la-zoning"
      ],
      "feature_type": "zoning_feature",
      "min_zoom_for_new_data": 13,
      "retrieval": "ArcGIS viewport IDs, then selected geometry in chunks; retained feature geometries."
    },
    {
      "id": "census",
      "label": "LA County tract demographics",
      "presentation": "single_metric_choropleth",
      "selection_element": "acs-metric",
      "source_ids": [
        "tiger-tracts",
        "acs2024"
      ],
      "feature_type": "census_tract",
      "min_zoom_for_new_data": 12,
      "retrieval": "TIGERweb tract GeoJSON restricted to visible region; Census Reporter aggregate estimates joined using 14000US-prefixed tract GEOIDs."
    },
    {
      "id": "assessed_land_value",
      "label": "LA County tax-roll assessed land values",
      "presentation": "fixed_band_choropleth",
      "selection_element": "acs-metric",
      "source_ids": [
        "lacounty-assessor-parcels"
      ],
      "feature_type": "cadastral_parcel",
