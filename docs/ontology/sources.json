      "source_id": "la-zoning",
      "source_kind": "vector_feature_api",
      "delivery_kind": "arcgis_geojson",
      "dataset_id": "dataset:la-city-zoning",
      "feature_type": "zoning_feature",
      "scope": "la_city_pilot",
      "semantic_role": "planning_designation",
      "runtime": {
        "module": "web/zoning.js",
        "map_layer": "zoning",
        "selector_value": "zoning"
      },
      "identity": {
        "namespace": "la-city-planning-feature-server-15",
        "key": "OBJECTID",
        "secondary_attribute": "Zoning"
      },
      "time_model": "provider_updated",
      "measures": [
        "zoning_designation",
        "zoning_category"
      ]
    },
    {
      "source_id": "tiger-tracts",
      "source_kind": "vector_feature_api",
      "delivery_kind": "arcgis_geojson",
      "dataset_id": "dataset:tiger-acs2024-tracts",
      "feature_type": "census_tract",
      "scope": "la_county_pilot",
      "semantic_role": "statistical_geography",
      "runtime": {
        "module": "web/census.js",
        "map_layer": "census",
        "selector_value": "acs-metric"
      },
      "identity": {
        "namespace": "us-census-tigerweb-acs2024",
        "key": "GEOID",
        "format": "11_digit_census_tract_code"
      },
      "time_model": "fixed_geography_vintage"
    },
    {
      "source_id": "acs2024",
      "source_kind": "statistical_tabulation_api",
      "delivery_kind": "tabulation_json",
      "dataset_id": "dataset:acs2024-five-year",
      "feature_type": "census_tract",
      "scope": "la_county_pilot",
      "semantic_role": "tract_aggregate_estimate",
      "runtime": {
        "module": "web/census.js",
        "map_layer": "census",
        "selector_value": "acs-metric"
      },
      "identity": {
        "namespace": "census-reporter-acs2024",
        "key": "geo_id",
        "format": "14000US{GEOID}"
      },
      "time_model": "survey_period",
      "joins_to": {
        "source_id": "tiger-tracts",
        "left": "14000US{GEOID}",
        "right": "GEOID",
        "rule": "prefix '14000US' to 11-digit tract GEOID"
      },
      "measures": [
        "median_household_income",
        "median_household_income_moe",
        "tract_population",
        "female_share",
        "hispanic_share",
        "nonhispanic_white_alone_share"
      ]
    },
    {
      "source_id": "lacounty-assessor-parcels",
      "source_kind": "vector_feature_api",
      "delivery_kind": "arcgis_geojson",
      "dataset_id": "dataset:la-county-assessor-parcels",
      "feature_type": "cadastral_parcel",
      "scope": "la_county_pilot",
      "semantic_role": "tax_roll_assessment",
      "runtime": {
        "module": "web/parcel.js",
        "map_layer": "assessed_land_value",
        "selector_value": "assessor"
      },
      "identity": {
        "namespace": "la-county-assessor-arcgis-feature-server-0",
        "key": "OBJECTID",
        "secondary_attribute": "AIN"
      },
      "time_model": "per_feature_roll_year",
      "measures": [
        "assessed_land_value",
        "assessed_improvement_value"
      ]
    },
